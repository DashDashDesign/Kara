  "6": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["15", 0], "shift": 3 }, "_meta": { "title": "ModelSamplingAuraFlow" } },
  "7": { "class_type": "EmptySD3LatentImage", "inputs": { "width": 1024, "height": 1280, "batch_size": 1 }, "_meta": { "title": "Empty Latent" } },
  "8": { "class_type": "KSampler", "inputs": { "model": ["6", 0], "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["7", 0], "seed": 1, "steps": 8, "cfg": 1, "sampler_name": "res_multistep", "scheduler": "simple", "denoise": 1 }, "_meta": { "title": "KSampler" } },
  "9": { "class_type": "VAEDecode", "inputs": { "samples": ["8", 0], "vae": ["3", 0] }, "_meta": { "title": "VAE Decode" } },
