  "12": { "class_type": "ImageScale", "inputs": { "image": ["11", 0], "upscale_method": "lanczos", "width": 1024, "height": 1280, "crop": "center" }, "_meta": { "title": "Guide size" } },
  "13": { "class_type": "Canny", "inputs": { "image": ["12", 0], "low_threshold": 0.1, "high_threshold": 0.32 }, "_meta": { "title": "Canny" } },
