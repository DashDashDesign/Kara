# Copy this file to ".env" (same folder) and fill it in. ".env" is never committed.

# local = your own ComfyUI (default).
# cloud = Comfy Cloud, no GPU needed (paid plan).
# magnific = Magnific API, Z-Image Turbo, no GPU and no ComfyUI.
COMFY_MODE=local

# Only for cloud mode. Create a key at https://platform.comfy.org (Profile > API Keys).
# The API needs a paid Comfy Cloud plan.
COMFY_CLOUD_API_KEY=

# Optional: another ComfyUI address in local mode.
# COMFY_URL=http://127.0.0.1:8188

# Only for magnific mode. Create a key in your Magnific API dashboard (docs.magnific.com).
MAGNIFIC_API_KEY=
